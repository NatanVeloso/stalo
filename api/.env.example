# Copie para .env e preencha. Nada daqui vai para o git.

NODE_ENV=development
PORT=3000

# Origens do site permitidas no CORS, separadas por vírgula. Em produção o nginx
# serve site e API na mesma origem, então pode ficar vazio (CORS desligado).
CORS_ORIGINS=http://localhost:5173

# Banco SQLite, imagens baixadas e migrações (caminhos relativos à pasta api/).
DATABASE_PATH=./data/stalo.sqlite
MEDIA_DIR=./data/media
MIGRATIONS_DIR=./drizzle

# Token de longa duração da conta @staloconsulting (Meta for Developers →
# Instagram → Gerar token). Vazio = sincronização desligada; a API continua
# servindo o que já está no banco.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_URL=https://graph.instagram.com

# Chave AES-256 em hex (64 caracteres) para guardar o token renovado no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Chave do endpoint administrativo POST /api/sync (header x-api-key), mínimo 32
# caracteres. Vazio = endpoint desativado.
ADMIN_API_KEY=

# Sincronização: expressão cron (padrão: a cada hora), quantas publicações
# recentes acompanhar e se roda uma vez ao subir.
SYNC_CRON=0 * * * *
SYNC_MAX_POSTS=60
SYNC_ON_BOOT=true

# Vídeos: baixar o mp4 para tocar no próprio site (true) ou só a thumbnail, com
# o vídeo abrindo no Instagram (false). Limite de tamanho por arquivo, em MB.
SYNC_DOWNLOAD_VIDEOS=false
SYNC_VIDEO_MAX_MB=100
